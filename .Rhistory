df %>% group_by(country) %>% summarise(mean_age = sum(life_expectancy)) %>% slice_max(mean_age, n=5) %>% select(country)
#Tìm ra 5 quốc gia có tuổi thọ trung bình cao nhất năm 2015 và gán thành top_5
