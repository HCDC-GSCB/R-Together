#Biểu đồ đường thể hiện xu hướng tuổi thọ
plot_data <- df %>% filter(country == c("Brazil", "Cambodia", "Belgium", "Austria"))
ggplot(plot_data, aes(x = year, y = life_expectancy, group = country)) +
geom_line() +
labs(
title = "Xu hướng tuổi thọ từ 2000 đến 2015",
x = "Năm",
y = "Tuổi thọ (Năm)"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
axis.title = element_text(size = 12),
legend.position = "bottom"
)
ggplot(plot_data, aes(x = year, y = life_expectancy, colour = country)) +
geom_line() +
labs(
title = "Xu hướng tuổi thọ từ 2000 đến 2015",
x = "Năm",
y = "Tuổi thọ (Năm)"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
axis.title = element_text(size = 12),
legend.position = "bottom"
)
ggplot(plot_data, aes(x = year, y = life_expectancy, colour = country)) +
geom_line() +
labs(
title = "Xu hướng tuổi thọ từ 2000 đến 2015",
x = "Năm",
y = "Tuổi thọ (Năm)"
) +
scale_x_continuous(breaks = seq(2000, 2015, by = 3)) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
axis.title = element_text(size = 12),
legend.position = "bottom"
)
