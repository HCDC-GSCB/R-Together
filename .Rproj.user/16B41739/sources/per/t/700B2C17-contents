## Loading neccessary package and data

```{r, echo = FALSE}

library(tidyverse)
library(skimr)
library(lubridate)
library(janitor)
library(gtsummary)

df <- read.csv("../day1/data/life-exp.csv")
```

## Khám phá dữ liệu

```{r, echo=FALSE}
view(df)

#chuyển dữ liệu thành tibble
df <- as_tibble(df) %>% clean_names()


#kiểm tra các loại dữ liệu
str(df)

#kiểm tra xem các biến có bị mất dữ liệu không
skimr::skim(df)

#Thay đổi tên cột cho đúng quy tắc
df <- df  %>% rename(life_expectancy = Life.expectancy,
              adult_mortality = Adult.Mortality,
              infant_deaths = infant.deaths,
              percentage_expenditure = percentage.expenditure,
              Hepatitis_B = Hepatitis.B,
              under_five_deaths = under.five.deaths,
              total_expenditure = Total.expenditure,
              HIV_AIDS = HIV.AIDS,
              thinness_1_19_years = thinness..1.19.years,
              thinness_5_9_years = thinness.5.9.years,
              income_composition_of_resources =     Income.composition.of.resources) 

#Chuyển các biến về loại dữ liệu hợp lý
df <- df %>% mutate(status = as.factor(status),
                    country = as.factor(country))

```

##Xử lý và phân tích dữ liệu
```{r, echo=FALSE}

df_diseases <- df %>% select(measles, polio, diphtheria)
head(df_diseases)

#Truy xuất hàng 2 cột 5
df[2,5]

#Thay thế giá trị missing của cột life expectancy (cột life expectancy không có mất dữ liệu)
sum(is.na(df$life_expectancy))

#Truy xuất hàng 2,5 và cột Measles, Polio 
df[c(2,5), c("measles","polio")]

#Tìm ra 5 quốc gia có tuổi thọ trung bình cao nhất năm 2015 và gán thành top_5
top_5 <- df %>% filter(year == 2015) %>% group_by(country) %>% summarise(mean_age = sum(life_expectancy)) %>% slice_max(mean_age, n=5) %>% select(country)

#Tìm ra 5 quốc gia có tuổi thọ trung bình thấp nhất năm 2015 và gán thành top_5
bot_5 <- df %>% filter(year == 2015) %>% group_by(country) %>% summarise(mean_age = sum(life_expectancy)) %>% slice_min(mean_age, n=5) %>% select(country)

#Tạo 1 data frame chứa 2 đối tượng top_5 và bot_5 và gán thành df_top_bot
df_top_bot <- rbind(top_5, bot_5)


#Tạo biến mới bmi_lv là biến thứ tự gồm các nhóm: dưới 18.5, từ 18.5 đến 23, trên 23.
df <- df %>% mutate(bmi_lv = case_when(bmi < 18.5 ~ "dưới 18.5",
                                 bmi >= 18.5 & bmi <= 23 ~ "từ 18.5 đến 23",
                                 bmi > 23 ~ "trên 23"))

#Sử dụng df nhóm theo country để tính trung bình GDP và gán thành df_gdp_by_country.

df_gdp_by_country <- df %>% group_by(country) %>% summarise(mean_gdp = mean(gdp))
  
```


## Tạo bảng thống kê năm 2014
```{r, echo=FALSE}
#Lọc dữ liệu 2015
df %>% filter(year == 2014) %>% tbl_summary(
  by = status,
  include = c(life_expectancy,adult_mortality,gdp,schooling,bmi),
  label = list(
    life_expectancy ~ "Kỳ vọng sống (năm)",
    adult_mortality ~ "Tử vong ở người lớn",
    gdp ~ "Thu nhập đầu người",
    schooling ~ "Mức độ học vấn",
    bmi ~ "BMI (kg/m2)"
  ), 
  missing = "no",
   statistic = list(
      Life_Expectancy = "{mean} ({min} - {max})",
      Adult_Mortality = "{mean} ({min} - {max})",
      GDP = "{mean} ({min} - {max})",
      Schooling = "{mean} ({min} - {max})", #all_continuous() ~ "{mean} ({min} to {max})"
      BMI = "{median} ({p25} - {p75})"
    )
) %>% add_p(
  test = list(all_continuous() ~ "wilcox.test"),
    pvalue_fun = ~style_pvalue(.x, digits = 3)
) %>% add_overall() %>%  
      bold_labels()
#modify header
```




## Trực quan hóa dữ liệu
```{r, echo=FALSE}
library(ggplot2)

#Biểu đồ đường thể hiện xu hướng tuổi thọ
plot_data <- df %>% filter(country == c("Brazil", "Cambodia", "Belgium", "Austria"))

ggplot(plot_data, aes(x = year, y = life_expectancy, colour = country)) + 
  geom_line() +
  labs(
    title = "Xu hướng tuổi thọ từ 2000 đến 2015",
    x = "Năm",
    y = "Tuổi thọ (Năm)"
    ) + 
  scale_x_continuous(breaks = seq(2000, 2015, by = 3)) +
   theme_minimal() +
   theme(
    plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
    axis.title = element_text(size = 12),
    legend.position = "bottom"
  )

```
```{r, echo=FALSE}
#Biểu đồ thể hiện mối quan hệ giữa 2 biến GDP và tuổi thọ
ggplot(plot_data, aes(x = gdp, y = life_expectancy, color = status, size = gdp)) +
  geom_point(alpha = 0.8) +
  scale_x_log10() +
  scale_color_manual(values = c("Developing" = "#1b9e77", "Developed" = "#d95f02"))+
  labs(
    title = "Mối quan hệ giữa GDP và Tuổi thọ năm 2015",
    x = "GDP (USD)",
    y = "Tuổi thọ (năm)",
    color = "Trạng thái",
    size = "Dân số"
  ) +
  theme_minimal()
  

```


##Viết function
```{r, echo=FALSE}

create_plot <- function(country_name, indicator) {
    # Kiểm tra xem indicator có phải là một cột trong dataframe không
    if (!indicator %in% colnames(df)) {
        stop(paste("Chỉ số '", indicator, "' không tồn tại trong bộ dữ liệu.", sep = ""))
    }
    
    # Lọc dữ liệu cho quốc gia cụ thể
    country_data <- df %>% filter(country == country_name)
    
    # Kiểm tra xem có dữ liệu cho quốc gia đó không
    if (nrow(country_data) == 0) {
        return(paste("Không tìm thấy dữ liệu cho quốc gia:", country_name))
    }
    
    # Vẽ biểu đồ
    p <- ggplot(data = country_data, aes(x = year, y = .data[[indicator]])) +
        geom_line(color = "darkblue", size = 1) +
        geom_point(color = "darkblue") +
        labs(
            title = paste("Xu Hướng chỉ số", indicator, "của", country_name),
            subtitle = "Giai đoạn 2000-2015",
            x = "Năm",
            y = indicator
        ) +
        theme_bw()
    
    return(p)
}

```













